APP_NAME=JPBA
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://jpba.example.jp
APP_TIMEZONE=Asia/Tokyo
APP_LOCALE=ja
APP_FALLBACK_LOCALE=ja
APP_FAKER_LOCALE=ja_JP

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=jpba_production
DB_USERNAME=jpba_app
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=null

QUEUE_CONNECTION=database
CACHE_STORE=database
FILESYSTEM_DISK=local

MAIL_MAILER=smtp
MAIL_SCHEME=
MAIL_HOST=smtp.example.jp
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@example.jp
MAIL_FROM_NAME="${APP_NAME}"

JPBA_ACHIEVEMENT_CUTOVER_DATE=
JPBA_BACKUP_KEY_PATH=
JPBA_BACKUP_RETENTION_GENERATIONS=14
JPBA_BACKUP_RESTORE_DB_PREFIX=jpba_restore_
JPBA_PG_DUMP_BINARY=pg_dump
JPBA_PG_RESTORE_BINARY=pg_restore
JPBA_CREATEDB_BINARY=createdb
JPBA_DROPDB_BINARY=dropdb
JPBA_PSQL_BINARY=psql

VITE_APP_NAME="${APP_NAME}"
